# Configuración pública de la demo local; no pongas aquí claves reales.
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000
APP_URL_IMAGE=http://localhost:8000/storage/
FRONTEND_URL=http://localhost/

# MySQL dentro de la red Docker.
DB_CONNECTION=mysql
DB_HOST=bd
DB_PORT=3306
DB_DATABASE=street_connect
DB_USERNAME=streetconnect
DB_PASSWORD=root

# Reverb local para el chat en tiempo real.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=streetconnect-demo
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_APP_CLUSTER=mt1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
VITE_REVERB_APP_KEY=local-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=ws

# Correo: log evita SMTP en la demo sin credenciales externas.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=demo@example.com
MAIL_FROM_NAME=StreetConnect

# Integraciones opcionales: déjalas vacías para la demo.
GROK_API_KEY=
GEMINI_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Contraseñas de las cuentas creadas por los seeders.
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_USER_PASSWORD=UsuarioDemo123!